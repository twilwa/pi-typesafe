# Set in your shell or a local .env; leave blank for offline development.
TYPESAFE_API_KEY=
# Optional SDK overrides:
# TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai
