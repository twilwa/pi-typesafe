{
  "name": "pi-typesafe",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Jev pre-flight guard and diff critic for Pi",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/unit/*.test.ts test/integration/*.test.ts",
    "test:unit": "node --test test/unit/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env --test test/integration/*.test.ts",
    "lint:semantic": "bash scripts/lint-semantic.sh",
    "bench:jev": "node scripts/jev-bench.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "smoke:jev": "node --env-file-if-exists=.env scripts/smoke-jev.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@eslint/js": "10.0.1",
    "@shahriarbijoy/eslint-plugin-jev": "0.3.0",
    "@types/node": "24.13.5",
    "eslint": "10.10.0",
    "prettier": "3.9.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.1 <0.88.0"
  }
}
